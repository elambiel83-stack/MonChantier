# Base de données PostgreSQL (obligatoire) : remplace l'ancienne persistance
# en fichiers JSON (data/*.json), incompatible avec un déploiement serverless
# ou plusieurs instances. Voir db/schema.sql (à rejouer à chaque déploiement,
# `npm run db:migrate`).
DATABASE_URL=postgres://user:password@localhost:5432/monchantier

# Redis (optionnel) : quand défini, le rate limiting (login admin, OTP) est
# partagé entre toutes les instances du serveur au lieu d'être en mémoire
# locale à chaque process.
REDIS_URL=

# Cloudflare Turnstile (optionnel) : anti-bot sur le login admin et la demande
# de code OTP par téléphone. Non configuré, la vérification est un no-op
# (comme dans le dépôt Chantier).
TURNSTILE_SECRET_KEY=

# Mobile Money — voir lib/mobileMoney.ts. Sans configuration, Mobile Money
# est refusé (503) en production ; en dev/local, un mode démo simule une
# confirmation immédiate pour tester le parcours sans prestataire réel.
#
# Mode "flutterwave" : appelle réellement l'API Flutterwave v3
# (mobile_money_franco), seul MOBILE_MONEY_API_KEY est requis.
# Mode "generic" (défaut) : contrat REST simple pour brancher n'importe quel
# agrégateur — MOBILE_MONEY_API_URL et MOBILE_MONEY_VERIFY_URL requis.
MOBILE_MONEY_PROVIDER=flutterwave

# Clé API (Bearer token) du prestataire (obligatoire dans les deux modes)
MOBILE_MONEY_API_KEY=

# Mode "generic" uniquement : endpoint d'initiation du paiement, doit répondre
# en JSON {status:'pending'|'success'|'failed', providerReference?, redirectUrl?}
MOBILE_MONEY_API_URL=

# Mode "generic" uniquement : endpoint de vérification (GET ?reference=<tx_ref>),
# doit répondre {status:'successful'|'failed'|'pending', amount, currency}
MOBILE_MONEY_VERIFY_URL=

# SMTP (emails de devis + envoi automatique des factures client)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
SMTP_SECURE=

# Email qui reçoit les notifications de nouveaux tickets support / nouveaux
# messages client (optionnel, prioritaire sur SMTP_TO pour le support)
SUPPORT_NOTIFICATION_EMAIL=

# Ingestion email des tickets support (lib/inboundMail.ts) : un client peut
# écrire directement à l'adresse support sans jamais se connecter au site.
# Fonctionne par polling IMAP, déclenché par un planificateur externe (cron)
# qui appelle POST /api/support/inbound-poll avec ce secret en Bearer token —
# voir README pour un exemple de configuration (Vercel Cron ou autre).
#
# Optionnel : par défaut réutilise SMTP_HOST/SMTP_USER/SMTP_PASS (la même
# boîte mail sert à la fois pour l'envoi SMTP et la lecture IMAP, cas
# courant). Ne renseigner SUPPORT_IMAP_* que pour une boîte différente.
SUPPORT_IMAP_HOST=
SUPPORT_IMAP_PORT=993
SUPPORT_IMAP_USER=
SUPPORT_IMAP_PASSWORD=
SUPPORT_IMAP_SECURE=true

# Secret pour appeler POST /api/support/inbound-poll (Authorization: Bearer <valeur>)
SUPPORT_INBOUND_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
APPLE_ID=
APPLE_SECRET=

# Stripe (paiement carte)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# SMS OTP (Africa's Talking) — username "sandbox" pour tester
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Accès admin: emails autorisés (via connexion Google/Facebook), séparés par des virgules
ADMIN_EMAILS=

# MFA administrateur (obligatoire en production) : secret Base32 dans une app TOTP.
ADMIN_TOTP_SECRET=

# Connexion admin par mot de passe (formulaire /auth/signin, provider "admin-login").
ADMIN_LOGIN_EMAIL=
# Dev uniquement : mot de passe en clair. En production, préférez
# ADMIN_LOGIN_PASSWORD_HASH (hash Argon2id, ex: via `npx argon2-cli hash`).
ADMIN_LOGIN_PASSWORD=
ADMIN_LOGIN_PASSWORD_HASH=

# Secret pour appeler POST /api/payments/confirm en usage manuel/ops (Authorization: Bearer <valeur>)
ADMIN_API_SECRET=

# --- Couche SaaS multi-tenant additive (voir README "Multi-tenant (SaaS)") ---
# N'affecte pas l'app mono-tenant MonChantier existante ci-dessus.

# Emails des opérateurs de la plateforme (toi, l'éditeur du SaaS) — console
# /platform, distincte des admins de chaque tenant.
PLATFORM_ADMIN_EMAILS=

# Abonnement Stripe Billing des tenants (plans payants). Sans ces 3 variables,
# POST /api/tenants/me/billing/checkout renvoie 503 — le plan starter (gratuit)
# reste utilisable.
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
# Secret du endpoint webhook Stripe dédié à la facturation SaaS
# (/api/webhooks/stripe-billing) — distinct de STRIPE_WEBHOOK_SECRET
# ci-dessus (paiements ponctuels de commandes) : à déclarer comme un
# deuxième endpoint webhook dans le Dashboard Stripe.
STRIPE_BILLING_WEBHOOK_SECRET=
